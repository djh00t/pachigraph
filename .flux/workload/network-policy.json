{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "pachigraph",
    "namespace": "codex-specops"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app.kubernetes.io/name": "pachigraph"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "envoy-gateway-system"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 3000
          }
        ]
      }
    ]
  }
}
