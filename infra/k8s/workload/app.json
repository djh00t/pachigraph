{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "pachigraph",
        "namespace": "codex-specops"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "pachigraph"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "pachigraph"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "imagePullSecrets": [
              {
                "name": "ghcr-read"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 30,
            "containers": [
              {
                "name": "pachigraph",
                "image": "ghcr.io/djh00t/pachigraph@sha256:40add1e46120da0b2598fef45a5e893fd76dec3820d500537a48e280fcbae74a",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 3000
                  }
                ],
                "env": [
                  {
                    "name": "VINEXT_TRUSTED_HOSTS",
                    "value": "pachigraph.e164sip.com"
                  },
                  {
                    "name": "POSTGRES_PASSWORD_URLENCODED",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "codex-specops-runtime",
                        "key": "POSTGRES_PASSWORD_URLENCODED"
                      }
                    }
                  },
                  {
                    "name": "DATABASE_URL",
                    "value": "postgresql://postgres:$(POSTGRES_PASSWORD_URLENCODED)@postgres:5432/specops"
                  },
                  {
                    "name": "AWS_ACCESS_KEY_ID",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "codex-specops-runtime",
                        "key": "PERSONAL_ACCESS_AWS_KEY_ID"
                      }
                    }
                  },
                  {
                    "name": "AWS_SECRET_ACCESS_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "codex-specops-runtime",
                        "key": "PERSONAL_AWS_SECRET_ACCESS_KEY"
                      }
                    }
                  },
                  {
                    "name": "AWS_REGION",
                    "value": "ap-southeast-2"
                  },
                  {
                    "name": "S3_BUCKET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "pachigraph",
                        "key": "s3-bucket"
                      }
                    }
                  },
                  {
                    "name": "PACHIGRAPH_OIDC_ISSUER",
                    "value": "https://sso.e164sip.com/realms/codex-specops"
                  },
                  {
                    "name": "PACHIGRAPH_OIDC_AUDIENCE",
                    "value": "pachigraph"
                  },
                  {
                    "name": "PACHIGRAPH_OIDC_JWKS_URL",
                    "value": "http://keycloak/realms/codex-specops/protocol/openid-connect/certs"
                  },
                  {
                    "name": "PACHIGRAPH_ALLOWED_SUBJECTS",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "pachigraph",
                        "key": "allowed-subjects"
                      }
                    }
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 5,
                  "failureThreshold": 30
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "periodSeconds": 30,
                  "timeoutSeconds": 5
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "768Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "64Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "pachigraph",
        "namespace": "codex-specops"
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "pachigraph"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": "http"
          }
        ]
      }
    }
  ]
}
